# MertFormer Titan — Build30-V2 (example env)
# Fill secrets locally; never commit real tokens.

# Required for online teacher + gated datasets
HF_TOKEN=

# Optional experiment tracking
WANDB_API_KEY=

# Training profile and token budget
TITAN_PROFILE=fixed_steps
TITAN_TOKEN_BUDGET_MODE=fixed_steps
TITAN_TARGET_TOKENS_MIN=23600000000
TITAN_MAX_STEPS=45000

# Offline/online controls
TITAN_OFFLINE=1
TITAN_WANDB=0

# Precomputed logits path (offline distillation)
TITAN_LOGITS_PATH=./datasets/logits/

# Accelerate config regeneration (set 1 to force)
TITAN_FORCE_ACCELERATE_RECONF=0

# Preflight controls
TITAN_PREFLIGHT_ALLOW_MISSING_STAGE_JSONL=0
TITAN_PREFLIGHT_WRITE_CUDA_LOCK=0

# SOP controls
SOP_AUTO_COMMIT=0
SOP_AUTO_PUSH=0
SOP_PLOT_TRAINING_LOG=1
