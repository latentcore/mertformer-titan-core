{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mertformer.local/interfaces/workspace_hygiene_manifest_v1.schema.json",
  "title": "Workspace Hygiene Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_utc",
    "mode",
    "workspace_root",
    "repo_root",
    "quarantine_root",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "workspace_hygiene_manifest_v1"
    },
    "generated_utc": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "audit_only",
        "apply_quarantine"
      ]
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "quarantine_root": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification",
          "reason",
          "restore_target",
          "decision_state"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "restore_target": {
            "type": "string"
          },
          "decision_state": {
            "type": "string",
            "enum": [
              "keep",
              "quarantine_first",
              "ignore"
            ]
          }
        }
      }
    }
  }
}
